<main
  id="wedding-page"
  class="relative isolate min-h-screen overflow-x-clip bg-[#f5f8fa] text-[#3d4450]"
>
  <%!-- ===== Hero: save the date ===== --%>
  <section
    id="wedding-hero"
    class="relative flex min-h-svh flex-col overflow-hidden"
    data-wedding-welcome
  >
    <img
      id="wedding-background"
      src={~p"/images/wedding-meadow.jpg"}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-30 h-full w-full object-cover object-left sm:portrait:object-[18%_center] landscape:object-[42%_center]"
    />
    <div class="absolute inset-0 -z-20 bg-[radial-gradient(58%_52%_at_50%_40%,rgba(247,250,252,0.68),rgba(247,250,252,0))]">
    </div>
    <div class="absolute inset-x-0 top-0 -z-10 h-36 bg-gradient-to-b from-[#f5f8fa]/60 to-transparent">
    </div>

    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <span class="welcome-petal left-[9%] top-[19%] bg-[#f5b8c9] [animation-delay:100ms]"></span>
      <span class="welcome-petal left-[21%] top-[12%] bg-[#f7d7b8] [animation-delay:350ms]">
      </span>
      <span class="welcome-petal left-[72%] top-[17%] bg-[#bad9c3] [animation-delay:500ms]">
      </span>
      <span class="welcome-petal left-[84%] top-[29%] bg-[#efc3d8] [animation-delay:250ms]">
      </span>
      <span class="welcome-petal left-[60%] top-[8%] bg-[#c4d8ef] [animation-delay:700ms]"></span>
    </div>

    <div class="relative mx-auto flex w-full max-w-6xl flex-1 flex-col items-center px-5 pt-10 sm:px-9 sm:pt-12">
      <header class="reveal flex w-full items-center justify-between">
        <div class="grid size-12 place-items-center rounded-full border border-[#eef4f8]/80 bg-[#f7fafc]/75 shadow-[0_16px_40px_rgba(85,108,130,0.14)] backdrop-blur-sm">
          <span class="font-wedding-serif text-base leading-none tracking-tight text-[#424b57]">
            B<span class="mx-px text-[0.7em] text-[#9fb89f]">&amp;</span>B
          </span>
        </div>
        <span class="rounded-full border border-[#eef4f8]/80 bg-[#f7fafc]/75 px-4 py-2 text-[0.65rem] font-medium uppercase tracking-[0.34em] text-[#5c6a78] backdrop-blur-sm">
          Save the date
        </span>
      </header>

      <div class="flex flex-1 flex-col items-center justify-center py-16 text-center sm:py-20">
        <p class="reveal text-[0.68rem] font-medium uppercase tracking-[0.55em] text-[#4f7584] [animation-delay:80ms]">
          The wedding of
        </p>

        <h1 class="reveal mt-2 font-wedding-script text-[3.25rem] leading-snug text-[#3d4450] [animation-delay:160ms] min-[360px]:text-6xl sm:text-7xl lg:text-8xl">
          Bee <span class="text-[#7aa58d]">&amp;</span> Boom
        </h1>

        <div
          class="reveal mt-6 flex items-center gap-4 [animation-delay:240ms]"
          aria-hidden="true"
        >
          <span class="h-px w-10 bg-gradient-to-r from-transparent to-[#a4bacb] sm:w-16"></span>
          <.icon name="hero-heart-solid" class="size-4 text-[#e8a7b9]" />
          <span class="h-px w-10 bg-gradient-to-l from-transparent to-[#a4bacb] sm:w-16"></span>
        </div>

        <p
          id="wedding-date"
          class="reveal mt-6 font-wedding-serif text-3xl tracking-[0.14em] text-[#495363] [animation-delay:320ms] sm:text-4xl lg:text-5xl"
        >
          01 · 11 · 2026
        </p>
        <p class="reveal mt-2 text-base text-[#6b7783] [animation-delay:360ms] sm:text-lg">
          วันอาทิตย์ที่ ๑ พฤศจิกายน พ.ศ. ๒๕๖๙
        </p>

        <div
          id="wedding-countdown"
          data-countdown="2026-11-01T15:09:00+07:00"
          class="reveal mt-10 flex items-stretch divide-x divide-[#d4e0e9] rounded-2xl border border-[#eef4f8] bg-[#f7fafc]/70 px-2 py-4 shadow-[0_18px_45px_rgba(85,108,130,0.13)] backdrop-blur-sm [animation-delay:440ms] sm:px-4"
        >
          <div class="w-16 px-2 text-center sm:w-20">
            <p
              data-count-d
              class="font-wedding-serif text-3xl leading-none text-[#495363] sm:text-4xl"
            >
              0
            </p>
            <p class="mt-1.5 text-[0.52rem] uppercase tracking-[0.12em] text-[#617080] sm:text-[0.6rem] sm:tracking-[0.28em]">
              Days
            </p>
          </div>
          <div class="w-16 px-2 text-center sm:w-20">
            <p
              data-count-h
              class="font-wedding-serif text-3xl leading-none text-[#495363] sm:text-4xl"
            >
              00
            </p>
            <p class="mt-1.5 text-[0.52rem] uppercase tracking-[0.12em] text-[#617080] sm:text-[0.6rem] sm:tracking-[0.28em]">
              Hours
            </p>
          </div>
          <div class="w-16 px-2 text-center sm:w-20">
            <p
              data-count-m
              class="font-wedding-serif text-3xl leading-none text-[#495363] sm:text-4xl"
            >
              00
            </p>
            <p class="mt-1.5 text-[0.52rem] uppercase tracking-[0.12em] text-[#617080] sm:text-[0.6rem] sm:tracking-[0.28em]">
              Minutes
            </p>
          </div>
          <div class="w-16 px-2 text-center sm:w-20">
            <p
              data-count-s
              class="font-wedding-serif text-3xl leading-none text-[#495363] sm:text-4xl"
            >
              00
            </p>
            <p class="mt-1.5 text-[0.52rem] uppercase tracking-[0.12em] text-[#617080] sm:text-[0.6rem] sm:tracking-[0.28em]">
              Seconds
            </p>
          </div>
        </div>

        <a
          id="wedding-open-invitation"
          href="#wedding-invitation"
          class="reveal mt-10 inline-flex items-center gap-2 rounded-full border border-[#8fae83]/40 bg-[#8fae83] px-7 py-3 text-sm font-medium tracking-[0.2em] text-white uppercase shadow-[0_16px_38px_rgba(122,165,141,0.4)] transition duration-300 hover:-translate-y-0.5 hover:bg-[#7ba275] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4f7584] focus-visible:ring-offset-2 focus-visible:ring-offset-[#f7fafc] [animation-delay:520ms]"
        >
          เปิดการ์ดเชิญ <.icon name="hero-arrow-down" class="size-4" />
        </a>
      </div>

      <div class="reveal pb-8 text-[#8a95a1] [animation-delay:640ms]" aria-hidden="true">
        <.icon name="hero-chevron-down" class="size-5 float-gentle" />
      </div>
    </div>
  </section>

  <%!-- ===== Floating music player ===== --%>
  <div
    id="wedding-music-player"
    class="music-player"
    data-music-player
    data-state="paused"
  >
    <audio
      id="wedding-music"
      src={~p"/audio/canon-in-d.mp3"}
      autoplay
      loop
      preload="metadata"
      data-music-audio
    >
    </audio>

    <button
      id="wedding-music-toggle"
      type="button"
      class="music-player-control"
      aria-label="Play Canon in D"
      aria-pressed="false"
      data-music-toggle
    >
      <span class="music-player-disc" aria-hidden="true">
        <.icon name="hero-musical-note" class="size-4" />
      </span>
      <span class="music-player-copy min-w-0 flex-1 text-left">
        <span class="block text-[0.58rem] font-semibold tracking-[0.3em] text-[#6b7a87] uppercase">
          Our song
        </span>
        <span
          class="mt-0.5 block truncate font-wedding-serif text-sm italic text-[#43505d]"
          aria-live="polite"
          data-music-status
        >
          Starting softly…
        </span>
      </span>
      <span class="music-player-action" aria-hidden="true">
        <.icon name="hero-play-solid" class="music-player-play size-3.5" />
        <.icon name="hero-pause-solid" class="music-player-pause size-3.5" />
      </span>
    </button>
  </div>

  <%!-- ===== Invitation arch, mirroring the card ===== --%>
  <section
    id="wedding-invitation"
    aria-labelledby="wedding-invitation-title"
    class="relative overflow-hidden bg-[#f5f8fa] px-5 pt-6 pb-24 sm:px-9 lg:min-h-svh lg:pt-14 lg:pb-32"
  >
    <h2 id="wedding-invitation-title" class="sr-only">คำเชิญร่วมพิธีมงคลสมรส</h2>

    <div aria-hidden="true">
      <span class="cloud-blob left-[-4rem] top-24 size-56"></span>
      <span class="cloud-blob right-[-3rem] top-64 size-44"></span>
      <span class="petal-drift left-[12%] top-[38%] bg-[#f5b8c9]"></span>
      <span class="petal-drift right-[14%] top-[18%] bg-[#c4d8ef] [animation-delay:1.9s]"></span>
    </div>

    <div class="relative mx-auto max-w-2xl" data-reveal data-invitation-card>
      <div class="overflow-hidden rounded-t-[10rem] rounded-b-3xl border border-[#d7e1e9] bg-white/80 pb-12 text-center shadow-[0_30px_80px_rgba(85,108,130,0.13)] backdrop-blur-sm sm:rounded-t-[14rem] lg:pb-16">
        <div class="relative px-6 pt-14 sm:px-14 lg:pt-20">
          <div class="mx-auto flex max-w-xs items-center justify-center gap-4" aria-hidden="true">
            <span class="h-px w-14 bg-gradient-to-r from-transparent to-[#c2d1dd]"></span>
            <span class="grid size-16 shrink-0 place-items-center rounded-full border border-[#d7e1e9] bg-[#fafcfd] shadow-[0_10px_28px_rgba(85,108,130,0.12)]">
              <span class="font-wedding-serif text-lg tracking-[0.08em] text-[#424b57]">
                B<span class="mx-0.5 text-[0.75em] text-[#9fb89f]">&amp;</span>B
              </span>
            </span>
            <span class="h-px w-14 bg-gradient-to-l from-transparent to-[#c2d1dd]"></span>
          </div>

          <div class="mt-8 grid gap-6 text-sm leading-relaxed text-[#5c6a78] sm:grid-cols-[1fr_auto_1fr] sm:gap-8 lg:mt-10">
            <div>
              <p>นายมนัส โตสารเดช (คุณพ่อ)</p>
              <p>นางประภาพร โตสารเดช (คุณแม่)</p>
            </div>
            <div class="self-center font-wedding-serif text-lg italic text-[#9fb89f]">และ</div>
            <div>
              <p>นายพีระพล แผ่วสูงเนิน (คุณพ่อ)</p>
              <p>นางรวงพลอย แผ่วสูงเนิน (คุณแม่)</p>
            </div>
          </div>

          <p class="mt-8 text-[0.95rem] leading-relaxed text-[#5c6a78] lg:mt-10">
            มีความยินดีขอเรียนเชิญท่านเพื่อเป็นเกียรติ<br />ในพิธีมงคลสมรสระหว่าง
          </p>

          <div class="mt-8 grid items-center gap-1 sm:grid-cols-[1fr_auto_1fr] sm:gap-6 lg:mt-10">
            <div class="sm:text-right">
              <p class="font-wedding-script text-4xl text-[#3d4450] sm:text-5xl">Passaraporn</p>
              <p class="mt-2 text-sm text-[#5c6a78]">นางสาวภัสราภรณ์ โตสารเดช</p>
              <p class="mt-0.5 text-sm font-semibold text-[#4f7c67]">(บี)</p>
            </div>
            <div class="my-4 grid place-items-center sm:my-0">
              <span class="grid size-9 place-items-center rounded-full bg-[#f2c3a6]/25">
                <.icon name="hero-heart-solid" class="size-5 text-[#e8a07e]" />
              </span>
            </div>
            <div class="sm:text-left">
              <p class="font-wedding-script text-4xl text-[#3d4450] sm:text-5xl">Pongsatorn</p>
              <p class="mt-2 text-sm text-[#5c6a78]">นายพงศธร แผ่วสูงเนิน</p>
              <p class="mt-0.5 text-sm font-semibold text-[#567188]">(บูม)</p>
            </div>
          </div>

          <div class="mx-auto mt-10 h-px w-40 bg-gradient-to-r from-transparent via-[#c2d1dd] to-transparent lg:mt-12">
          </div>

          <p class="mt-8 font-wedding-serif text-xl tracking-[0.06em] text-[#495363] lg:mt-10">
            วันอาทิตย์ที่ ๑ พฤศจิกายน ๒๕๖๙
          </p>
          <p class="mt-3 flex items-center justify-center gap-2 text-sm text-[#5c6a78]">
            <.icon name="hero-map-pin" class="size-4 text-[#e8a7b9]" />
            Misstar Cafe by Davika Wedding Venue, Bangkok
          </p>
          <p class="mt-7 text-xs leading-relaxed text-[#66737f] lg:mt-9">
            ขออภัยหากมิได้มาเรียนเชิญด้วยตนเอง
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ===== Photo story ===== --%>
  <section
    id="wedding-story"
    aria-labelledby="wedding-story-title"
    class="relative overflow-hidden border-y border-[#34414a] bg-[#28323a] py-28 text-white sm:py-36"
  >
    <div class="relative mx-auto flex max-w-6xl items-end justify-between gap-8 px-5 sm:px-9">
      <div class="max-w-xl" data-reveal>
        <p class="text-[0.68rem] font-medium uppercase tracking-[0.5em] text-[#b9cbd7]">
          Us, in little moments
        </p>
        <h2
          id="wedding-story-title"
          class="mt-3 font-wedding-serif text-4xl text-white sm:text-5xl"
        >
          เรื่องราวของเรา
        </h2>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-white/65">
          ค่อย ๆ เลื่อน แล้วปล่อยให้ภาพเหล่านี้เล่าเรื่องของเรา
        </p>
      </div>

      <div
        class="hidden items-center gap-3 sm:flex"
        role="group"
        aria-label="ตัวควบคุมแกลเลอรีภาพ"
      >
        <button
          id="wedding-story-previous"
          type="button"
          data-photo-previous
          aria-label="ภาพก่อนหน้า"
          class="grid size-12 place-items-center rounded-full border border-white/20 bg-white/8 text-white transition duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 disabled:pointer-events-none disabled:opacity-30"
        >
          <.icon name="hero-arrow-left" class="size-5" />
        </button>
        <button
          id="wedding-story-next"
          type="button"
          data-photo-next
          aria-label="ภาพถัดไป"
          class="grid size-12 place-items-center rounded-full border border-white/20 bg-white/8 text-white transition duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 disabled:pointer-events-none disabled:opacity-30"
        >
          <.icon name="hero-arrow-right" class="size-5" />
        </button>
      </div>
    </div>

    <div class="relative mt-10 sm:mt-14" data-photo-gallery data-reveal>
      <div
        id="wedding-story-photos"
        class="photo-story-rail"
        data-photo-rail
        tabindex="0"
        role="region"
        aria-label="ภาพเรื่องราวของบีและบูม"
      >
        <figure class="photo-story-slide" data-photo-slide data-active="true">
          <div class="photo-story-frame">
            <img
              src={~p"/images/bee-boom-studio.webp"}
              alt="บีและบูมในชุดแต่งงาน ถ่ายภาพขาวดำในสตูดิโอ"
              width="1800"
              height="2701"
              loading="lazy"
              class="h-full w-full object-cover"
            />
            <div class="photo-story-shade" aria-hidden="true"></div>
            <figcaption class="photo-story-caption">
              <span class="photo-story-number">01</span>
              <p class="font-wedding-script text-4xl leading-none sm:text-5xl">Side by side</p>
              <p class="mt-2 text-xs tracking-[0.24em] text-white/65 uppercase">เคียงข้างกัน</p>
            </figcaption>
          </div>
        </figure>

        <figure class="photo-story-slide" data-photo-slide data-active="false">
          <div class="photo-story-frame">
            <img
              src={~p"/images/bee-boom-mountain-selfie.webp"}
              alt="บีและบูมโชว์แหวนระหว่างทริปท่ามกลางภูเขาและลำธาร"
              width="1600"
              height="2134"
              loading="lazy"
              class="h-full w-full object-cover object-left"
            />
            <div class="photo-story-shade" aria-hidden="true"></div>
            <figcaption class="photo-story-caption">
              <span class="photo-story-number">02</span>
              <p class="font-wedding-script text-4xl leading-none sm:text-5xl">Our adventure</p>
              <p class="mt-2 text-xs tracking-[0.24em] text-white/65 uppercase">
                การเดินทางของเรา
              </p>
            </figcaption>
          </div>
        </figure>

        <figure class="photo-story-slide" data-photo-slide data-active="false">
          <div class="photo-story-frame">
            <img
              src={~p"/images/bee-boom-mountain-adventure.webp"}
              alt="บีและบูมยืนเล่นกันริมลำธารท่ามกลางภูเขา"
              width="1600"
              height="1067"
              loading="lazy"
              class="h-full w-full object-cover object-[80%_center]"
            />
            <div class="photo-story-shade" aria-hidden="true"></div>
            <figcaption class="photo-story-caption">
              <span class="photo-story-number">03</span>
              <p class="font-wedding-script text-4xl leading-none sm:text-5xl">Just us</p>
              <p class="mt-2 text-xs tracking-[0.24em] text-white/65 uppercase">แค่เราสองคน</p>
            </figcaption>
          </div>
        </figure>

        <figure class="photo-story-slide" data-photo-slide data-active="false">
          <div class="photo-story-frame">
            <img
              src={~p"/images/bee-boom-rings-and-bouquet.webp"}
              alt="มือของบีและบูมสวมแหวนคู่ ชูเคียงช่อดอกไม้ใต้ต้นไม้ใหญ่"
              width="1600"
              height="1067"
              loading="lazy"
              class="h-full w-full object-cover object-center"
            />
            <div class="photo-story-shade" aria-hidden="true"></div>
            <figcaption class="photo-story-caption">
              <span class="photo-story-number">04</span>
              <p class="font-wedding-script text-4xl leading-none sm:text-5xl">The beginning</p>
              <p class="mt-2 text-xs tracking-[0.24em] text-white/65 uppercase">
                วันแรกของตลอดไป
              </p>
            </figcaption>
          </div>
        </figure>

        <figure class="photo-story-slide" data-photo-slide data-active="false">
          <div class="photo-story-frame">
            <img
              src={~p"/images/bee-boom-garden-portrait.webp"}
              alt="บีและบูมถือช่อดอกไม้และยืนเคียงกันใต้ต้นไม้ใหญ่"
              width="1600"
              height="2400"
              loading="lazy"
              class="h-full w-full object-cover object-center"
            />
            <div class="photo-story-shade" aria-hidden="true"></div>
            <figcaption class="photo-story-caption">
              <span class="photo-story-number">05</span>
              <p class="font-wedding-script text-4xl leading-none sm:text-5xl">In bloom</p>
              <p class="mt-2 text-xs tracking-[0.24em] text-white/65 uppercase">
                ความรักกำลังผลิบาน
              </p>
            </figcaption>
          </div>
        </figure>

        <figure class="photo-story-slide" data-photo-slide data-active="false">
          <div class="photo-story-frame">
            <img
              src={~p"/images/bee-boom-promise.webp"}
              alt="บีสวมแหวนให้บูมริมทะเลยามเย็น"
              width="1800"
              height="2706"
              loading="lazy"
              class="h-full w-full object-cover"
            />
            <div class="photo-story-shade" aria-hidden="true"></div>
            <figcaption class="photo-story-caption">
              <span class="photo-story-number">06</span>
              <p class="font-wedding-script text-4xl leading-none sm:text-5xl">The promise</p>
              <p class="mt-2 text-xs tracking-[0.24em] text-white/65 uppercase">คำสัญญาของเรา</p>
            </figcaption>
          </div>
        </figure>

        <figure class="photo-story-slide" data-photo-slide data-active="false">
          <div class="photo-story-frame">
            <img
              src={~p"/images/bee-boom-little-things.webp"}
              alt="ช่อดอกไม้ ริบบิ้น และรายละเอียดเล็ก ๆ ในวันพิเศษของบีและบูม"
              width="1800"
              height="2706"
              loading="lazy"
              class="h-full w-full object-cover"
            />
            <div class="photo-story-shade" aria-hidden="true"></div>
            <figcaption class="photo-story-caption">
              <span class="photo-story-number">07</span>
              <p class="font-wedding-script text-4xl leading-none sm:text-5xl">Little things</p>
              <p class="mt-2 text-xs tracking-[0.24em] text-white/65 uppercase">ความสุขเล็ก ๆ</p>
            </figcaption>
          </div>
        </figure>

        <figure class="photo-story-slide" data-photo-slide data-active="false">
          <div class="photo-story-frame">
            <img
              src={~p"/images/bee-boom-always.webp"}
              alt="บีและบูมโอบกอดกันใต้ผ้าคลุมหน้าในแสงเย็น"
