<main
  id="coming-soon-page"
  class="relative isolate min-h-screen overflow-hidden bg-[#d8ebfb] text-[#383332]"
>
  <img
    id="coming-soon-background"
    src={~p"/images/coming-soon-meadow.jpg"}
    alt=""
    aria-hidden="true"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-30 h-full w-full object-cover object-left sm:object-[42%_center]"
  />
  <div class="absolute inset-0 -z-20 bg-[linear-gradient(180deg,rgba(255,251,244,0.24)_0%,rgba(255,251,244,0.1)_42%,rgba(255,251,244,0.34)_100%)]">
  </div>
  <div class="absolute inset-x-0 top-0 -z-10 h-40 bg-gradient-to-b from-[#f8fbff]/70 to-transparent">
  </div>

  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <span class="petal-drift left-[9%] top-[19%] bg-[#f5b8c9]"></span>
    <span class="petal-drift left-[21%] top-[12%] bg-[#f7d7b8] [animation-delay:1.6s]"></span>
    <span class="petal-drift left-[72%] top-[17%] bg-[#bad9c3] [animation-delay:.9s]"></span>
    <span class="petal-drift left-[84%] top-[29%] bg-[#efc3d8] [animation-delay:2.4s]"></span>
  </div>

  <div class="relative mx-auto flex min-h-screen w-full max-w-7xl flex-col px-5 py-5 sm:px-9 sm:py-8 lg:px-12">
    <header
      id="coming-soon-header"
      class="coming-soon-reveal flex items-center justify-between gap-4 text-[0.68rem] font-medium uppercase tracking-[0.34em] text-[#57514f]/80"
    >
      <div class="flex items-center gap-3">
        <div class="grid size-11 place-items-center rounded-full border border-[#fff7ed]/70 bg-[#fffaf1]/72 font-wedding-serif text-base normal-case tracking-normal text-[#45403e] shadow-[0_16px_40px_rgba(91,105,83,0.14)] backdrop-blur-sm">
          B&amp;B
        </div>
        <span>Bee &amp; Boom</span>
      </div>
      <span class="hidden sm:inline">Bangkok</span>
    </header>

    <section
      id="coming-soon-hero"
      aria-labelledby="coming-soon-title"
      class="flex flex-1 items-center justify-center pb-28 pt-16 text-center sm:pb-32 lg:pb-40"
    >
      <div class="coming-soon-reveal max-w-3xl [animation-delay:120ms]">
        <p class="font-wedding-sans text-[0.68rem] font-semibold uppercase tracking-[0.5em] text-[#5f8998]">
          Save the date
        </p>

        <h1
          id="coming-soon-title"
          class="mt-5 font-wedding-serif text-5xl leading-[0.95] tracking-normal text-[#423c3b] sm:text-7xl lg:text-8xl"
        >
          Bee <span class="text-[#7aa58d]">&amp;</span> Boom
        </h1>

        <p
          id="wedding-date"
          class="mt-6 font-wedding-serif text-2xl tracking-normal text-[#4f4947] sm:text-3xl"
        >
          Sunday, 01 November 2026
        </p>

        <p class="mx-auto mt-5 max-w-2xl font-wedding-sans text-base leading-8 text-[#5b5552] sm:text-lg">
          Our wedding website is blooming soon with ceremony details, maps, RSVP,
          and a little corner for guest wishes and cute photo memories.
        </p>

        <div
          id="coming-soon-notes"
          class="mt-9 flex flex-col items-center justify-center gap-3 text-sm font-medium text-[#4d4745] sm:flex-row"
        >
          <span class="inline-flex min-h-11 items-center gap-2 rounded-full border border-[#fff6e8]/80 bg-[#fffaf0]/72 px-4 py-2 shadow-[0_14px_38px_rgba(96,111,91,0.13)] backdrop-blur-sm transition duration-300 hover:-translate-y-0.5 hover:bg-[#fffaf0]/88">
            <.icon name="hero-envelope-open" class="size-4 text-[#d99daf]" />
            Guest wishes opening soon
          </span>
          <span class="inline-flex min-h-11 items-center gap-2 rounded-full border border-[#fff6e8]/80 bg-[#fffaf0]/72 px-4 py-2 shadow-[0_14px_38px_rgba(96,111,91,0.13)] backdrop-blur-sm transition duration-300 hover:-translate-y-0.5 hover:bg-[#fffaf0]/88">
            <.icon name="hero-photo" class="size-4 text-[#7fa7c4]" /> Photo memories board
          </span>
        </div>
      </div>
    </section>

    <footer
      id="coming-soon-footer"
      class="coming-soon-reveal flex flex-col gap-4 border-t border-white/55 py-5 text-sm text-[#504b48] [animation-delay:240ms] sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="flex items-center gap-2">
        <.icon name="hero-map-pin" class="size-4 text-[#7da48a]" />
        Misstar Cafe by Davika Wedding Venue, Bangkok
      </p>

      <div class="flex items-center gap-2" aria-label="Wedding theme colors">
        <span class="size-3 rounded-full bg-[#6d9bd1]"></span>
        <span class="size-3 rounded-full bg-[#78a88e]"></span>
        <span class="size-3 rounded-full bg-[#bdd6a8]"></span>
        <span class="size-3 rounded-full bg-[#d8d4ee]"></span>
        <span class="size-3 rounded-full bg-[#f4c5ad]"></span>
        <span class="size-3 rounded-full bg-[#efb7c2]"></span>
        <span class="size-3 rounded-full bg-[#f3d56f]"></span>
      </div>
    </footer>
  </div>
</main>

<Layouts.flash_group flash={@flash} />
