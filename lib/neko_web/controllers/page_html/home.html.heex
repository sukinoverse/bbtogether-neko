        </p>
        <p class="hidden tracking-[0.22em] uppercase sm:block">Scroll to wander</p>
        <div class="flex items-center gap-3">
          <button
            id="wedding-story-autoplay"
            type="button"
            data-photo-autoplay
            aria-label="หยุดการเลื่อนภาพอัตโนมัติ"
            aria-pressed="false"
            class="grid size-11 place-items-center rounded-full border border-white/15 bg-white/5 text-white/75 transition duration-300 hover:border-white/35 hover:bg-white/12 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
          >
            <.icon name="hero-pause-solid" class="photo-story-pause size-3.5" />
            <.icon name="hero-play-solid" class="photo-story-play hidden size-3.5" />
          </button>
          <p
            class="font-wedding-serif text-base tracking-[0.18em] text-white/80"
            aria-live="polite"
          >
            <span data-photo-current>01</span><span class="mx-2 text-white/30">/</span>31
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ===== Schedule ===== --%>
  <section
    id="wedding-schedule"
    class="relative overflow-hidden bg-gradient-to-b from-[#f5f8fa] via-[#e8edf3] to-[#eaf2f8] px-5 py-20 sm:px-9 sm:py-28"
  >
    <div aria-hidden="true">
      <span class="cloud-blob left-[-5rem] top-16 size-64"></span>
      <span class="cloud-blob right-[-4rem] top-1/3 size-52"></span>
      <span class="cloud-blob left-[10%] bottom-10 size-40"></span>
      <span class="petal-drift left-[8%] top-[24%] bg-[#bad9c3]"></span>
      <span class="petal-drift right-[10%] top-[60%] bg-[#f5b8c9] [animation-delay:1.4s]"></span>
    </div>

    <div class="relative mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-[0.68rem] font-medium uppercase tracking-[0.5em] text-[#617080]">
        Our day, together
      </p>
      <h2 class="mt-3 font-wedding-serif text-3xl text-[#3d4450] sm:text-4xl">
        กำหนดการพิธีมงคลสมรส
      </h2>
      <div class="mx-auto mt-5 flex items-center justify-center gap-3" aria-hidden="true">
        <span class="h-px w-12 bg-[#bccfdf]"></span>
        <.icon name="hero-heart-solid" class="size-3.5 text-[#e8a7b9]" />
        <span class="h-px w-12 bg-[#bccfdf]"></span>
      </div>
    </div>

    <ol id="wedding-schedule-list" class="wedding-timeline relative mx-auto mt-14 max-w-2xl">
      <li
        :for={event <- @events}
        class="relative grid grid-cols-[var(--time-col)_2.5rem_1fr] items-start pb-8 last:pb-0"
        data-schedule-item
        data-reveal
      >
        <span class="pt-3 pr-1 text-right font-wedding-serif text-lg font-medium text-[#65707d]">
          {event.time} น.
        </span>
        <span class="relative flex justify-center pt-4">
          <span
            class="z-10 size-3.5 rounded-full shadow-[0_0_0_4px_rgba(255,255,255,0.8)]"
            style={"background-color:#{event.color}"}
          >
          </span>
        </span>
        <div
          class="group ml-3 flex items-center gap-4 rounded-2xl px-5 py-4 shadow-[0_14px_40px_rgba(85,108,130,0.1)] backdrop-blur-sm transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_22px_55px_rgba(85,108,130,0.16)] sm:ml-6"
          style={"background-color:#{event.color}12;border:1px solid #{event.color}40"}
        >
          <span
            class="grid size-11 shrink-0 place-items-center rounded-full"
            style={"background-color:#{event.color}30;color:#{event.color}"}
          >
            <.icon name={event.icon} class="size-5" />
          </span>
          <div class="min-w-0 text-left">
            <p class="font-medium text-[#3d4450]">{event.title}</p>
            <p class="font-wedding-serif text-sm italic text-[#617080]">{event.sub}</p>
          </div>
        </div>
      </li>
    </ol>
  </section>

  <%!-- ===== Venue ===== --%>
  <section
    id="wedding-venue"
    aria-labelledby="wedding-venue-title"
    class="relative overflow-hidden bg-gradient-to-b from-[#eaf2f8] to-[#f5f8fa] px-5 py-20 sm:px-9 sm:py-28"
  >
    <span class="cloud-blob left-[-4rem] bottom-16 size-56" aria-hidden="true"></span>

    <div
      class="group relative mx-auto max-w-5xl overflow-hidden rounded-[2.5rem] border border-white/80 bg-white/75 shadow-[0_30px_90px_rgba(95,137,152,0.2)] md:grid md:grid-cols-[1.15fr_0.85fr]"
      data-reveal
    >
      <figure class="relative min-h-80 overflow-hidden sm:min-h-[26rem] md:min-h-[34rem]">
        <img
          src={~p"/images/misstar-garden-chapel.jpg"}
          alt="โบสถ์สีขาวท่ามกลางสวนของ Misstar Cafe by Davika Wedding Venue"
          width="960"
          height="640"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover transition duration-1000 ease-out group-hover:scale-[1.025]"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#1f2d2b]/65 via-transparent to-transparent"
          aria-hidden="true"
        >
        </div>
        <figcaption class="absolute right-7 bottom-7 left-7 text-white sm:right-10 sm:bottom-9 sm:left-10">
          <p class="text-[0.65rem] font-medium tracking-[0.38em] text-white/75 uppercase">
            The garden chapel
          </p>
          <p class="mt-2 font-wedding-script text-4xl leading-none sm:text-5xl">
            Where forever begins
          </p>
        </figcaption>
      </figure>

      <div class="relative flex flex-col items-center justify-center px-8 py-14 text-center sm:px-12 sm:py-16 md:px-10">
        <div class="float-gentle mx-auto grid size-14 place-items-center rounded-full border border-white/70 bg-white/85 text-[#7aa58d] shadow-[0_16px_40px_rgba(85,108,130,0.18)] backdrop-blur-sm">
          <.icon name="hero-map-pin" class="size-6" />
        </div>
        <p class="mt-6 text-[0.68rem] font-medium uppercase tracking-[0.5em] text-[#4f7584]">
          Venue
        </p>
        <h2
          id="wedding-venue-title"
          class="mt-3 font-wedding-serif text-3xl text-[#3d4450] sm:text-4xl"
        >
          สถานที่จัดงาน
        </h2>
        <span
          class="mt-6 h-px w-24 bg-gradient-to-r from-transparent via-[#a7bdc7] to-transparent"
          aria-hidden="true"
        >
        </span>
        <p class="mt-6 font-wedding-serif text-xl text-[#495363]">
          Misstar Cafe by Davika Wedding Venue
        </p>
        <p class="font-wedding-serif italic text-[#617080]">Bangkok, Thailand</p>
        <a
          href="https://www.google.com/maps/search/?api=1&query=Misstar+Cafe+by+Davika+Wedding+Venue"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-2 rounded-full border border-[#7c9cb4]/40 bg-[#7c9cb4] px-7 py-3 text-sm font-medium tracking-[0.2em] text-white uppercase shadow-[0_16px_38px_rgba(124,156,180,0.5)] transition duration-300 hover:-translate-y-0.5 hover:bg-[#6d8ca5] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4f7584] focus-visible:ring-offset-2 focus-visible:ring-offset-[#f7fafc]"
        >
          <.icon name="hero-map-pin" class="size-4" /> ดูเส้นทาง
        </a>
      </div>
    </div>
  </section>

  <%!-- ===== RSVP ===== --%>
  <section
    id="wedding-rsvp"
    aria-labelledby="wedding-rsvp-title"
    class="relative overflow-hidden bg-gradient-to-b from-[#f5f8fa] via-[#edf4f2] to-[#f5f8fa] px-5 py-20 sm:px-9 sm:py-28"
  >
    <div aria-hidden="true">
      <span class="cloud-blob left-[-5rem] top-12 size-64"></span>
      <span class="cloud-blob right-[-4rem] bottom-8 size-52"></span>
      <span class="petal-drift left-[9%] top-[24%] bg-[#f5b8c9]"></span>
      <span class="petal-drift right-[10%] bottom-[18%] bg-[#bad9c3] [animation-delay:1.5s]">
      </span>
    </div>

    <div class="relative mx-auto max-w-4xl" data-reveal>
      <div class="text-center">
        <p class="text-[0.68rem] font-medium uppercase tracking-[0.5em] text-[#617080]">
          Will you join us?
        </p>
        <h2
          id="wedding-rsvp-title"
          class="mt-3 font-wedding-serif text-3xl text-[#3d4450] sm:text-4xl"
        >
          มาร่วมฉลองไปกับเรา
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-[#617080]">
          บอกเราได้เลย แล้วเราจะเตรียมทุกอย่างไว้ต้อนรับคุณ
        </p>
      </div>

      <div class={[
        "mt-10 overflow-hidden rounded-[2.5rem] border border-white/85 bg-white/70 shadow-[0_32px_90px_rgba(85,108,130,0.16)] backdrop-blur-sm",
        @rsvp_response && "mx-auto max-w-2xl",
        !@rsvp_response && "md:grid md:grid-cols-[0.82fr_1.18fr]"
      ]}>
        <div
          :if={!@rsvp_response}
          class="relative flex min-h-72 flex-col items-center justify-center overflow-hidden border-b border-[#d7e1e9]/70 bg-gradient-to-br from-[#e4efe8] via-[#edf3eb] to-[#f7e9ed] px-8 py-12 text-center md:border-r md:border-b-0"
        >
          <span class="absolute -left-10 -top-10 size-36 rounded-full bg-white/45 blur-2xl">
          </span>
          <span class="absolute -right-12 -bottom-12 size-44 rounded-full bg-[#f4cbd7]/25 blur-2xl">
          </span>

          <div class="relative">
            <span class="mx-auto grid size-16 place-items-center rounded-full border border-white/90 bg-white/75 text-[#7aa58d] shadow-[0_14px_40px_rgba(85,108,130,0.14)]">
              <.icon name="hero-envelope-open" class="size-7" />
            </span>
            <p class="mt-7 font-wedding-script text-5xl leading-none text-[#3d4450]">
              A place for you
            </p>
            <div
              class="mx-auto mt-6 flex max-w-40 items-center gap-3 text-[#e8a7b9]"
              aria-hidden="true"
            >
              <span class="h-px flex-1 bg-gradient-to-r from-transparent to-[#b9cbd7]"></span>
              <.icon name="hero-heart-solid" class="size-4" />
              <span class="h-px flex-1 bg-gradient-to-l from-transparent to-[#b9cbd7]"></span>
            </div>
            <p class="mt-5 text-sm leading-relaxed text-[#5c6a78]">
              เพราะวันสำคัญจะพิเศษขึ้น<br />เมื่อมีคุณอยู่ด้วย
            </p>
          </div>
        </div>

        <div
          id="rsvp-panel"
          class={[
            "px-6 py-9 sm:px-10 sm:py-11",
            @rsvp_response && "sm:px-12 sm:py-12"
          ]}
        >
          <div
            :if={@rsvp_response}
            id="rsvp-success"
            role="status"
            aria-live="polite"
            class="relative flex min-h-[30rem] flex-col items-center justify-center overflow-hidden text-center"
          >
            <span class="absolute left-[12%] top-[12%] size-20 rounded-full bg-[#e5f0e9]/70 blur-2xl">
            </span>
            <span class="absolute right-[10%] bottom-[14%] size-24 rounded-full bg-[#f7dfe6]/70 blur-2xl">
            </span>

            <span class="relative grid size-20 place-items-center rounded-full border border-[#a9c4b6]/60 bg-[#e7f1eb] text-[#6f9b83] shadow-[0_16px_40px_rgba(111,155,131,0.2)]">
              <span class="absolute inset-2 rounded-full border border-white/90"></span>
              <.icon name="hero-check" class="relative size-8" />
            </span>
            <p
              id="rsvp-response-recorded"
              class="mt-6 inline-flex items-center gap-1.5 rounded-full border border-[#bad0c4]/70 bg-[#edf5f0] px-3 py-1.5 text-[0.65rem] font-semibold tracking-[0.08em] text-[#64806b]"
            >
              <.icon name="hero-check-circle" class="size-3.5" /> เราได้รับคำตอบของคุณแล้ว
            </p>
            <p class="mt-4 text-[0.62rem] font-semibold uppercase tracking-[0.38em] text-[#64806b]">
              {if(@rsvp_response.attending, do: "You’re all set", else: "Thank you")}
            </p>
            <h3 class="mt-3 font-wedding-serif text-3xl text-[#3d4450]">
              {if(@rsvp_response.attending, do: "แล้วเจอกันนะ", else: "ขอบคุณที่บอกเรานะ")}
            </h3>
            <p class="mt-4 max-w-sm text-sm leading-7 text-[#5c6a78]">
              <%= if @rsvp_response.attending do %>
                เราจะเตรียมไว้ต้อนรับ {@rsvp_response.name}<br />และครอบครัว รวม {@rsvp_response.party_size} ท่าน
              <% else %>
                หวังว่าจะได้เจอกันในโอกาสหน้า
              <% end %>
            </p>
            <dl class="mt-7 grid w-full max-w-md grid-cols-2 gap-px overflow-hidden rounded-2xl border border-[#d9e3e8] bg-[#d9e3e8] text-left">
              <div class="bg-white/85 px-4 py-3.5">
                <dt class="text-[0.62rem] font-semibold uppercase tracking-[0.12em] text-[#8a98a5]">
                  Name
                </dt>
                <dd class="mt-1 truncate text-sm font-medium text-[#3d4450]">
                  {@rsvp_response.name}
                </dd>
              </div>
              <div class="bg-white/85 px-4 py-3.5">
                <dt class="text-[0.62rem] font-semibold uppercase tracking-[0.12em] text-[#8a98a5]">
                  Phone
                </dt>
                <dd class="mt-1 text-sm font-medium text-[#3d4450]">
                  {masked_phone(@rsvp_response.phone)}
                </dd>
              </div>
              <div class="bg-white/85 px-4 py-3.5">
                <dt class="text-[0.62rem] font-semibold uppercase tracking-[0.12em] text-[#8a98a5]">
                  Response
                </dt>
                <dd class="mt-1 text-sm font-medium text-[#3d4450]">
                  {if(@rsvp_response.attending, do: "มาร่วมงาน", else: "ไม่สะดวกมาร่วมงาน")}
                </dd>
              </div>
              <div class="bg-white/85 px-4 py-3.5">
                <dt class="text-[0.62rem] font-semibold uppercase tracking-[0.12em] text-[#8a98a5]">
                  Guests
                </dt>
                <dd class="mt-1 text-sm font-medium text-[#3d4450]">
                  {if(@rsvp_response.attending,
                    do: "#{@rsvp_response.party_size} ท่าน",
                    else: "—"
                  )}
                </dd>
              </div>
            </dl>
            <div class="mt-7 flex items-center gap-3 text-[#e8a7b9]" aria-hidden="true">
              <span class="h-px w-12 bg-gradient-to-r from-transparent to-[#c8d7df]"></span>
              <.icon name="hero-heart-solid" class="size-3.5" />
              <span class="h-px w-12 bg-gradient-to-l from-transparent to-[#c8d7df]"></span>
            </div>
            <p class="mt-5 font-wedding-serif text-sm tracking-[0.16em] text-[#6b7783]">
              Bee &amp; Boom · 01.11.2026
            </p>
          </div>

          <div :if={!@rsvp_response}>
            <.form
              for={@rsvp_form}
              id="wedding-rsvp-form"
              action={~p"/rsvp"}
              method="post"
              class="space-y-6"
            >
              <.input
                field={@rsvp_form[:name]}
                id="rsvp-name"
                type="text"
                label="ชื่อที่เราเรียกคุณ / Name or nickname"
                autocomplete="name"
                maxlength="120"
                required
                placeholder="ชื่อเล่น นามปากกา หรือชื่อที่คุ้นเคย"
                class="mt-2 h-13 w-full rounded-2xl border border-[#cbd9e3] bg-white/85 px-4 text-[0.95rem] text-[#3d4450] shadow-sm outline-none transition placeholder:text-[#9aa7b2] focus:border-[#7aa58d] focus:ring-4 focus:ring-[#7aa58d]/12"
                error_class="border-[#d78fa5] ring-4 ring-[#d78fa5]/10"
              />

              <div>
                <.input
                  field={@rsvp_form[:phone]}
                  id="rsvp-phone"
                  type="tel"
                  label="เบอร์โทรศัพท์ / Phone number"
                  autocomplete="tel"
                  inputmode="tel"
                  maxlength="20"
                  required
                  placeholder="08x xxx xxxx"
                  class="mt-2 h-13 w-full rounded-2xl border border-[#cbd9e3] bg-white/85 px-4 text-[0.95rem] text-[#3d4450] shadow-sm outline-none transition placeholder:text-[#9aa7b2] focus:border-[#7aa58d] focus:ring-4 focus:ring-[#7aa58d]/12"
                  error_class="border-[#d78fa5] ring-4 ring-[#d78fa5]/10"
                />
                <p class="px-1 text-[0.7rem] leading-5 text-[#84919c]">
                  ใช้สำหรับติดต่อเกี่ยวกับการมาร่วมงาน
                </p>
              </div>

              <.input
                field={@rsvp_form[:attending]}
                id="rsvp-attending"
                type="select"
                label="มาร่วมงานกับเราไหม?"
                prompt="เลือกคำตอบ"
                options={[{"ไปแน่นอน", true}, {"เสียดาย ไปไม่ได้", false}]}
                required
                class="mt-2 h-13 w-full appearance-none rounded-2xl border border-[#cbd9e3] bg-white/85 px-4 text-[0.95rem] text-[#3d4450] shadow-sm outline-none transition focus:border-[#7aa58d] focus:ring-4 focus:ring-[#7aa58d]/12"
                error_class="border-[#d78fa5] ring-4 ring-[#d78fa5]/10"
              />

              <div
                id="rsvp-party-size-field"
                class={["rsvp-party-size-field", @show_party_size? && "is-visible"]}
                aria-hidden={to_string(!@show_party_size?)}
              >
                <div class="overflow-hidden">
                  <div class="rounded-2xl border border-[#bfd4ca] bg-[#e9f2ed]/70 px-5 py-4">
                    <.input
                      field={@rsvp_form[:party_size]}
                      id="rsvp-party-size"
                      type="select"
                      label="มาด้วยกันทั้งหมดกี่ท่าน?"
                      options={@party_size_options}
                      disabled={!@show_party_size?}
                      class="mt-2 h-12 w-full appearance-none rounded-xl border border-[#bdd0c6] bg-white/90 px-4 text-[0.95rem] text-[#3d4450] shadow-sm outline-none transition focus:border-[#7aa58d] focus:ring-4 focus:ring-[#7aa58d]/12"
                      error_class="border-[#d78fa5] ring-4 ring-[#d78fa5]/10"
                    />
                    <p class="mt-2 text-xs leading-relaxed text-[#617080]">
                      รวมตัวคุณ เด็ก และทุกคนในครอบครัวแล้ว
                    </p>
                  </div>
                </div>
              </div>

              <button
                id="rsvp-submit"
                type="submit"
                class="group inline-flex w-full items-center justify-center gap-2 rounded-full border border-[#7aa58d]/30 bg-[#7aa58d] px-7 py-3.5 text-sm font-medium tracking-[0.16em] text-white shadow-[0_16px_38px_rgba(122,165,141,0.35)] transition duration-300 hover:-translate-y-0.5 hover:bg-[#6f9b83] hover:shadow-[0_20px_46px_rgba(122,165,141,0.42)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4f7584] focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-70 phx-submit-loading:pointer-events-none phx-submit-loading:opacity-70"
              >
                ยืนยันคำตอบ
                <.icon
                  name="hero-heart"
                  class="size-4 transition-transform duration-300 group-hover:scale-110"
                />
              </button>

              <p class="flex items-center justify-center gap-1.5 text-center text-[0.7rem] text-[#66737f]">
                <.icon name="hero-lock-closed" class="size-3.5" /> เราใช้ข้อมูลนี้เพื่อเตรียมต้อนรับคุณเท่านั้น
              </p>
            </.form>
          </div>

          <p
            id="rsvp-contact-note"
            class="mt-7 border-t border-[#dbe4e9] pt-5 text-center text-sm leading-7 text-[#617080]"
          >
            หากต้องการเช็กคำตอบ ติดต่อบีหรือบูมได้เลยนะ
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ===== Seating plan ===== --%>
  <section
    id="wedding-seating"
    aria-labelledby="wedding-seating-title"
    class="relative overflow-hidden bg-[#f5f8fa] px-5 py-20 sm:px-9 sm:py-28"
  >
    <div aria-hidden="true">
      <span class="cloud-blob right-[-5rem] top-16 size-60"></span>
      <span class="petal-drift left-[10%] top-[28%] bg-[#bad9c3]"></span>
      <span class="petal-drift right-[12%] bottom-[20%] bg-[#c4d8ef] [animation-delay:1.7s]">
      </span>
    </div>

    <div class="relative mx-auto max-w-3xl text-center" data-reveal>
      <p class="text-[0.68rem] font-medium uppercase tracking-[0.5em] text-[#617080]">
        Find your place
      </p>
      <h2
        id="wedding-seating-title"
        class="mt-3 font-wedding-serif text-3xl text-[#3d4450] sm:text-4xl"
      >
        ที่นั่งของคุณ
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-[#617080]">
        ใกล้วันงาน กลับมาค้นหาโต๊ะและที่นั่งของคุณได้ที่นี่
      </p>

      <div class="mt-10 overflow-hidden rounded-[2.5rem] border border-white/80 bg-white/65 text-left shadow-[0_30px_80px_rgba(85,108,130,0.14)] backdrop-blur-sm sm:grid sm:grid-cols-[1.1fr_0.9fr]">
        <div
          class="border-b border-[#d7e1e9]/80 bg-gradient-to-br from-[#eaf2f8]/80 to-[#edf4ec]/80 p-8 sm:border-r sm:border-b-0 sm:p-10"
          aria-hidden="true"
        >
          <div class="relative mx-auto max-w-xs py-2">
            <span class="absolute -left-3 top-10 size-24 rounded-full bg-[#f5dce4]/50 blur-xl">
            </span>
            <span class="absolute -right-3 bottom-6 size-28 rounded-full bg-[#dcebe3]/70 blur-xl">
            </span>

            <div class="relative overflow-hidden rounded-t-[9rem] rounded-b-[2rem] border border-white/90 bg-white/65 px-6 pt-10 pb-8 text-center shadow-[0_20px_50px_rgba(85,108,130,0.12)]">
              <span class="mx-auto grid size-12 place-items-center rounded-full border border-[#d7e1e9] bg-white/80 text-[#7aa58d] shadow-sm">
                <.icon name="hero-user-group" class="size-5" />
              </span>
              <p class="mt-6 text-[0.6rem] font-medium tracking-[0.38em] text-[#617080] uppercase">
                Your place with us
              </p>
              <p class="mt-3 font-wedding-script text-4xl text-[#3d4450]">
                Bee <span class="text-[#9fb89f]">&amp;</span> Boom
              </p>
              <div class="mx-auto mt-6 flex max-w-36 items-center gap-3 text-[#e8a7b9]">
                <span class="h-px flex-1 bg-gradient-to-r from-transparent to-[#cbd9e3]"></span>
                <.icon name="hero-heart-solid" class="size-3.5" />
                <span class="h-px flex-1 bg-gradient-to-l from-transparent to-[#cbd9e3]"></span>
              </div>
              <p class="mt-5 font-wedding-serif text-sm tracking-[0.18em] text-[#617080]">
                01 · 11 · 2026
              </p>
            </div>
          </div>
        </div>

        <div
          id="wedding-seating-status"
          class="flex flex-col items-center justify-center px-8 py-10 text-center sm:px-10"
        >
          <span class="grid size-14 place-items-center rounded-full bg-[#8fa9c2]/15 text-[#6d8ca5]">
            <.icon name="hero-map" class="size-6" />
          </span>
          <span class="mt-6 rounded-full border border-[#8fa9c2]/25 bg-[#8fa9c2]/10 px-4 py-2 text-[0.65rem] font-semibold tracking-[0.3em] text-[#5f7f96] uppercase">
            Coming Soon
          </span>
          <p class="mt-5 font-wedding-serif text-lg leading-relaxed text-[#536270]">
            เราจะเปิดให้ค้นหาโต๊ะและที่นั่ง<br />ได้ที่นี่ใกล้วันงาน
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ===== Theme colors ===== --%>
  <section
    id="wedding-theme"
    class="relative overflow-hidden bg-gradient-to-b from-[#f5f8fa] to-[#e9eff4] px-5 pt-20 pb-24 sm:px-9"
  >
    <span class="cloud-blob right-[-4rem] top-10 size-48" aria-hidden="true"></span>

    <div class="relative mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-[0.68rem] font-medium uppercase tracking-[0.5em] text-[#617080]">
        Dress in our colors
      </p>
      <h2 class="mt-3 font-wedding-serif text-3xl text-[#3d4450] sm:text-4xl">สีธีมงาน</h2>
      <p class="mt-2 font-wedding-serif text-lg italic text-[#5d6d7a]">
        เลือกโทนพาสเทลที่คุณชอบ
        <span class="ml-1 inline-flex items-center gap-1.5 rounded-full bg-[#8fa9c2]/15 px-2.5 py-1 text-sm not-italic text-[#506c82]">
          <span class="size-1.5 rounded-full bg-[#8fa9c2]"></span> Dusty Blue เป็นสีหลัก
        </span>
      </p>
      <div
        class="mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-4"
        role="img"
        aria-label="Wedding palette led by Dusty Blue, followed by Powder Blue, Teal, Sage, Lilac, Peach, Blush, Orchid, and Butter Yellow"
      >
        <span
          :for={{color, i} <- Enum.with_index(@theme_colors)}
          aria-hidden="true"
          class="float-gentle grid size-12 place-items-center rounded-full shadow-[0_10px_24px_rgba(85,108,130,0.14)] ring-1 ring-white transition-transform duration-300 hover:-translate-y-1.5 sm:size-14"
          style={"background-color:#{color}33;color:#{color};animation-delay:#{i * 0.45}s"}
        >
          <.icon name="hero-heart-solid" class="size-5 sm:size-6" />
        </span>
      </div>
    </div>
  </section>

  <%!-- ===== Guestbook ===== --%>
  <section
    id="wedding-guestbook"
    aria-labelledby="wedding-guestbook-title"
    class="relative overflow-hidden bg-gradient-to-b from-[#e9eff4] to-[#eef4f2] px-5 py-20 sm:px-9 sm:py-28"
  >
    <div aria-hidden="true">
      <span class="cloud-blob left-[-5rem] top-10 size-64"></span>
      <span class="cloud-blob right-[-4rem] bottom-12 size-52"></span>
      <span class="petal-drift left-[13%] bottom-[24%] bg-[#f5b8c9]"></span>
      <span class="petal-drift right-[11%] top-[20%] bg-[#bad9c3] [animation-delay:1.3s]"></span>
    </div>

    <div class="relative mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-[0.68rem] font-medium uppercase tracking-[0.5em] text-[#617080]">
        Guestbook
      </p>
      <h2
        id="wedding-guestbook-title"
        class="mt-3 font-wedding-serif text-3xl text-[#3d4450] sm:text-4xl"
      >
        สมุดอวยพร
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-[#617080]">
        ร่วมฝากข้อความอวยพรและภาพความทรงจำให้เรา
      </p>

      <div class="relative mt-10 rounded-[2.5rem] border border-white/85 bg-white/65 p-2 shadow-[0_30px_80px_rgba(85,108,130,0.14)] backdrop-blur-sm">
        <div
          id="wedding-guestbook-status"
          class="rounded-[2.1rem] border border-dashed border-[#c7d6df] px-6 py-12 sm:px-12 sm:py-14"
        >
          <div class="flex items-center justify-center" aria-hidden="true">
            <span class="grid size-14 -rotate-6 place-items-center rounded-2xl border border-[#f0c9d4] bg-[#f9e8ed] text-[#d78fa5] shadow-[0_10px_24px_rgba(85,108,130,0.12)]">
              <.icon name="hero-chat-bubble-left-ellipsis" class="size-6" />
            </span>
            <span class="-ml-2 grid size-14 rotate-6 place-items-center rounded-2xl border border-[#bfd4ca] bg-[#e3f0e9] text-[#6e9e87] shadow-[0_10px_24px_rgba(85,108,130,0.12)]">
              <.icon name="hero-photo" class="size-6" />
            </span>
          </div>
          <span class="mt-7 inline-flex rounded-full border border-[#9fb89f]/30 bg-[#9fb89f]/10 px-4 py-2 text-[0.65rem] font-semibold tracking-[0.3em] text-[#64806b] uppercase">
            Coming Soon
          </span>
          <p class="mt-5 font-wedding-serif text-xl italic text-[#536270]">
            Your wishes, our keepsake
          </p>
          <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-[#617080]">
            อีกไม่นาน ที่นี่จะเต็มไปด้วยคำอวยพรและภาพความทรงจำจากทุกคน
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ===== Flower meadow horizon ===== --%>
  <div class="relative h-40 overflow-hidden sm:h-56" aria-hidden="true">
    <img
      src={~p"/images/meadow-flowers.jpg"}
      alt=""
      loading="lazy"
      class="absolute bottom-0 h-full w-full object-cover object-bottom"
    />
    <div class="absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-[#eef4f2] to-transparent">
    </div>
  </div>

  <footer class="bg-[#f5f8fa] px-5 py-8 text-center sm:px-9">
    <p class="font-wedding-serif text-lg tracking-[0.2em] text-[#5c6a78]">
      Bee <span class="text-[#9fb89f]">&amp;</span> Boom
    </p>
    <p class="mt-1 text-xs tracking-[0.3em] text-[#617080] uppercase">Sunday, 1 November 2026</p>
  </footer>
</main>

<Layouts.flash_group flash={@flash} />
